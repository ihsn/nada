<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!--
                OPTIONAL HARDENING RULES (disabled)

                To use them: delete the line containing only the opening comment marker and the line containing only the
                closing comment marker around the rules in the next block, keep the rules above the two
                rules that follow, test the site, then deploy.
                Requires the IIS URL Rewrite module (already needed by the rules below).

                What they do:
                  - return 404 for private folders (application, system, modules, vendor, logs, datafiles,
                    imports, cache, files/sessions), frontend sources, hidden files such as .git and .env,
                    source and notes files that exist on disk (.sql, .md, .log, ...) and PHP files other than
                    the front controller;
                  - leave routes alone: index.php/install, index.php/admin/logs and study downloads whose file
                    name ends in .log, .sql or .md still work.

                Known limit: a study resource downloaded through a URL without index.php whose file name ends
                in .php (for example /catalog/1/download/5/macro.php) is blocked by the PHP rule.

                Test before using in production: the site home page, the installer at index.php/install,
                a study download, and a request for /application/config/config.php (must return 404).
                -->
                <!--
                <rule name="Block private folders" stopProcessing="true">
                    <match url="^(application|system|modules|vendor|logs|datafiles|imports|cache|_trash|files/sessions)(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Block files in the install folder" stopProcessing="true">
                    <match url="^install/." ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Block frontend sources" stopProcessing="true">
                    <match url="^frontend/(?!dist(/|$))" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Block hidden version-control, environment and server files" stopProcessing="true">
                    <match url="(^|/)\.(git[^/]*|svn|hg|idea|vscode|claude|env[^/]*|ht[^/]*|DS_Store|npmrc)(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Block source and notes files" stopProcessing="true">
                    <match url="\.(sql|md|log|bak|old|orig|swp|sh|ps1|ini|env|dist|inc|lock)$" ignoreCase="true" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" />
                    </conditions>
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                <rule name="Block PHP files except the front controller" stopProcessing="true">
                    <match url="^(?!(.*/)?(index|openapi|swagger)\.php(/|$)).*\.(php[0-9]?|phtml|pht|phps|phar)(/|$)" ignoreCase="true" />
                    <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
                </rule>
                -->

                <rule name="Rewrite to index.php">
                    <match url="index.php|robots.txt|images|test.php" />
                    <action type="None" />
                </rule>
                <rule name="Rewrite CI Index">
                    <match url=".*" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" pattern="css|js|jpg|jpeg|png|gif|ico|htm|html|swf|svg|yaml" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php/{R:0}" />
                </rule>
            </rules>
        </rewrite>
        <security>
            <requestFiltering allowHighBitCharacters="false">
                <requestLimits maxAllowedContentLength="1900000000" />
                <!--
                OPTIONAL: hide source control and build folders (disabled).
                To use: delete the line containing only the opening comment marker and the line containing only the
                closing comment marker around the next block.
                -->
                <!--
                <hiddenSegments>
                    <add segment=".git" />
                    <add segment="node_modules" />
                </hiddenSegments>
                -->
            </requestFiltering>
        </security>
        <!--
        OPTIONAL: security response headers and removal of the X-Powered-By header (disabled).
        To use: delete the line containing only the opening comment marker and the line containing only the
        closing comment marker around the next block.
        If your server or a proxy already sets any of these headers, remove that line here to avoid duplicates.
        Strict-Transport-Security is not set here: turn on HSTS in IIS Manager (site Bindings) for HTTPS sites.
        To also hide the Server header, set removeServerHeader="true" on requestFiltering (IIS 10 and later only;
        older IIS stops the site with error 500.19 on that attribute).
        -->
        <!--
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Referrer-Policy" value="same-origin" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
            </customHeaders>
        </httpProtocol>
        -->
    </system.webServer>
</configuration>
